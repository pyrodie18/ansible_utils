{
  "name": "pyrodie18.utils",
  "image": "ghcr.io/pyrodie18/ansible-dev:2026.08.01",
  "remoteUser": "vscode",
  "runArgs": [
    "--security-opt",
    "seccomp=unconfined"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/ansible_collections/pyrodie18/utils,type=bind",
  "workspaceFolder": "/workspace/ansible_collections/pyrodie18/utils",
  "containerEnv": {
    "CODEX_HOME": "/home/vscode/.codex",
    "ANSIBLE_COLLECTIONS_PATH": "/workspace:/home/vscode/.ansible/collections"
  },
  "initializeCommand": "install -d -m 0700 -o 1000 -g 1000 ${localEnv:HOME}/.local/state/codex-dev/pyrodie18.utils",
  "mounts": [
    "type=bind,source=${localEnv:HOME}/.local/state/codex-dev/pyrodie18.utils,target=/home/vscode/.codex",
    "type=volume,source=pyrodie18-utils-uv-cache,target=/home/vscode/.cache/uv",
    "type=volume,source=pyrodie18-utils-ansible-cache,target=/home/vscode/.ansible"
  ],
  "postCreateCommand": "bootstrap-codex-home pyrodie18.utils && uv sync --frozen --group dev && uv run --frozen ansible-galaxy collection install -r requirements.yml -p /home/vscode/.ansible/collections",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.ansible",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
